{
  "annotations": { "list": [] },
  "editable": false,
  "title": "shimme.rs status",
  "description": "Availability of public shimme.rs services, measured from shimmers every 30 seconds.",
  "uid": "status",
  "tags": ["public"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Current service status",
      "description": "A failed check takes priority. A monitored endpoint without a fresh check is unknown, not healthy.",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A", "instant": true, "range": false,
        "expr": "min((last_over_time(probe_success{service!=\"\"}[90s]) and on(service) (up{service!=\"\"} == 1)) or on(service) (up{service!=\"\"} * 0 + 0.5)) or vector(0.5)"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "center", "text": { "valueSize": 32 }
      },
      "fieldConfig": {
        "defaults": { "noValue": "Unknown", "mappings": [{ "type": "value", "options": {
          "0": { "text": "Service disruption", "color": "red", "index": 0 },
          "0.5": { "text": "Checks missing", "color": "orange", "index": 1 },
          "1": { "text": "All services operational", "color": "green", "index": 2 }
        } }] }, "overrides": []
      }
    },
    {
      "id": 13, "type": "stat", "title": "Checks passed · 24h",
      "description": "Percentage of observed endpoint checks that succeeded during the past 24 hours. Missing checks are excluded.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A", "instant": true, "range": false,
        "expr": "100 * sum(sum_over_time(probe_success{service!=\"\"}[24h])) / sum(count_over_time(probe_success{service!=\"\"}[24h]))"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value", "colorMode": "none", "graphMode": "none"
      },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "noValue": "No checks" }, "overrides": [] }
    },
    {
      "id": 14, "type": "stat", "title": "Latest check",
      "description": "Time of the most recent probe sample. Checks run every 30 seconds; this dashboard refreshes every minute.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "range": false, "expr": "1000 * max(timestamp(probe_success{service!=\"\"}))" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value", "colorMode": "none", "graphMode": "none"
      },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsLocal", "noValue": "Unknown" }, "overrides": [] }
    },
    {
      "id": 15, "type": "table", "title": "Service availability",
      "description": "Failures and missing checks sort first. Availability is based on observed probes. Response time is the 95th percentile of measured probe durations over the past hour.",
      "gridPos": { "h": 15, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "range": false, "expr": "min by (service) ((last_over_time(probe_success{service!=\"\"}[90s]) and on(service) (up{service!=\"\"} == 1)) or on(service) (up{service!=\"\"} * 0 + 0.5))" },
        { "refId": "B", "format": "table", "instant": true, "range": false, "expr": "100 * avg by (service) (avg_over_time(probe_success{service!=\"\"}[24h]))" },
        { "refId": "C", "format": "table", "instant": true, "range": false, "expr": "100 * avg by (service) (avg_over_time(probe_success{service!=\"\"}[30d]))" },
        { "refId": "D", "format": "table", "instant": true, "range": false, "expr": "1000 * max by (service) (quantile_over_time(0.95, probe_duration_seconds{service!=\"\"}[1h]))" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "service", "mode": "outerTabular" } },
        { "id": "filterFieldsByName", "options": { "include": { "pattern": "^(service|Value.*)$" } } },
        { "id": "organize", "options": { "renameByName": {
          "service": "Service", "Value #A": "Status", "Value #B": "Uptime · 24h", "Value #C": "Uptime · 30d", "Value #D": "Response · p95"
        } } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Status", "desc": false }, { "displayName": "Service", "desc": false }] },
      "fieldConfig": {
        "defaults": { "noValue": "—", "custom": { "minWidth": 85 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [
            { "id": "noValue", "value": "Unknown" },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "mappings", "value": [{ "type": "value", "options": {
              "0": { "text": "Down", "color": "red", "index": 0 },
              "0.5": { "text": "Unknown", "color": "orange", "index": 1 },
              "1": { "text": "Operational", "color": "green", "index": 2 }
            } }] }
          ] },
          { "matcher": { "id": "byRegexp", "options": "/^Uptime/" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "Response · p95" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 }] }
        ]
      }
    },
    {
      "id": 2, "type": "state-timeline", "title": "Availability history",
      "description": "Each reading summarizes the preceding 5 minutes. A single failed check marks the window as disrupted. Gaps indicate missing observations.",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A", "instant": false, "range": true, "interval": "5m", "legendFormat": "{{service}}",
        "expr": "min by (service) (min_over_time(probe_success{service!=\"\"}[5m]) or on(service) (up{service!=\"\"} * 0 + 0.5))"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "custom": { "lineWidth": 0, "fillOpacity": 85, "spanNulls": false },
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "Failures", "color": "red", "index": 0 },
            "0.5": { "text": "No checks", "color": "dark-gray", "index": 1 },
            "1": { "text": "Passed", "color": "green", "index": 2 }
          } }]
        }, "overrides": []
      },
      "options": {
        "mergeValues": true, "showValue": "never", "rowHeight": 0.72,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    }
  ]
}
