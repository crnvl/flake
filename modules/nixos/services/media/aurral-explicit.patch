+
+  // nixos: reject the clean (edited) version by its tags, which often carry
+  // the rating when file and folder names don't. Counts as a failed
+  // download, so aurral moves on to the next source. A request that asks
+  // for clean keeps it. Only markers that mean "edited" count: iTunes
+  // advisory 2, or an edited/censored rating. A RATING=Clean text tag does
+  // not: Amazon and Qobuz rippers write it for every non-explicit track.
+  const cleanTag =
+    buildRequestVariantProfile(trackRequest).contentRating === "clean"
+      ? null
+      : Object.values(parsed?.native || {})
+          .flat()
+          .find((tag) => {
+            const id = String(tag?.id || "")
+              .toUpperCase()
+              .replace(/^TXXX:/, "");
+            const value = String(tag?.value ?? "")
+              .trim()
+              .toLowerCase();
+            if (id === "ITUNESADVISORY" || id === "RTNG") return value === "2";
+            if (id === "RATING" || id === "CONTENTRATING") {
+              return /^(edited|censored)$/.test(value);
+            }
+            return false;
+          });
+  if (cleanTag) {
+    return {
+      decision: POST_DOWNLOAD_DECISIONS.FAILED,
+      valid: false,
+      blocked: false,
+      reason: `downloaded file is the clean version (${cleanTag.id}=${cleanTag.value})`,
+      filePath,
+      quality: quality.quality,
+      actual: { tags: actual, durationMs: actualDurationMs },
       actualDurationMs,
       parsedTags: actual,
     };
